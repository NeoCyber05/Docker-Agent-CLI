{
  "name": "docker-agent",
  "version": "0.1.0",
  "description": "Natural-language CLI for managing Docker infrastructure via an LLM agent.",
  "type": "module",
  "bin": { "docker-agent": "./dist/cli.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/entrypoints/cli.ts",
    "build": "tsup src/entrypoints/cli.ts --format esm --target node20 --bundle --clean --out-dir dist && node -e \"require('fs').cpSync('src/prompts','dist/prompts',{recursive:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "precheck": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dockerode": "^4.0.2",
    "ink": "^5.0.1",
    "nanoid": "^5.0.7",
    "ollama": "^0.5.9",
    "openai": "^4.65.0",
    "react": "^18.3.1",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/dockerode": "^3.3.31",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@vitest/coverage-v8": "^2.1.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
